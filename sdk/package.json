{
  "name": "devnexus-sdk",
  "version": "1.0.2",
  "description": "Official SDK for DevNexus Incident Management System",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --clean",
    "dev": "tsup index.ts --format cjs,esm --watch --dts",
    "lint": "tsc --noEmit",
    "test": "npx tsx local-test.ts"
  },
  "keywords": [
    "error-tracking",
    "incident-management",
    "sdk",
    "devnexus"
  ],
  "author": "DevNexus Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
