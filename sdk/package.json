{
  "name": "devnexus-sdk",
  "version": "2.1.1",
  "description": "Official SDK for DevNexus Incident Management System",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts react.tsx --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "dev": "tsup index.ts react.tsx --format cjs,esm --watch --dts",
    "lint": "tsc --noEmit",
    "test": "npx tsx local-test.ts"
  },
  "keywords": [
    "error-tracking",
    "incident-management",
    "sdk",
    "devnexus"
  ],
  "author": "DevNexus Team",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
