generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@devnexus/prisma-client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  UNVERIFIED
}

enum PlanType {
  BASIC
  ADVANCED
  PRO
  ENTERPRISE
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum IssueSource {
  MANUAL
  GITHUB
  SDK
  AI
}

enum EnvironmentType {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum JobType {
  AI_ANALYZE
  EMAIL
  SLA_SWEEP
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum RoutingMatchType {
  TAG
  SEVERITY
  PATH_PREFIX
  MESSAGE_CONTAINS
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  plan      PlanType  @default(BASIC)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  users     User[]
  projects  Project[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           Role
  status         UserStatus   @default(UNVERIFIED)
  name           String?
  bio            String?
  image          String?
  phoneNumber    String?
  location       String?
  githubUrl      String?
  linkedinUrl    String?
  skills         String[]
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  emailVerifiedAt DateTime?
  deletedAt       DateTime?    // Soft delete
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedIssues Issue[]      @relation("AssignedTo")
  activities     IssueActivity[]
  comments       IssueComment[]
  createdProjects Project[]   @relation("CreatedProjects")
  notifications  Notification[]
  projectMemberships ProjectMembership[]
  teamMemberships TeamMembership[]
  auditLogs       AuditLog[]
  onCallRotationMemberships OnCallRotationMember[]

  @@index([orgId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'INCIDENT_CREATED', 'ASSIGNMENT', 'COMMENT', 'SLA'
  title     String
  message   String
  link      String?  // e.g., '/dashboard/issues/id'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model Project {
  id                   String       @id @default(cuid())
  name                 String
  description          String?
  techStack            String[]
  orgId                String
  organization         Organization @relation(fields: [orgId], references: [id])
  createdBy            String?
  creator              User?        @relation("CreatedProjects", fields: [createdBy], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?    // Soft delete

  plan                 PlanType     @default(BASIC)
  githubRepoUrl        String?
  githubInstallationId String?
  sdkApiKey            String?      @unique
  allowedOrigins       String[]     @default([])

  teams                Team[]
  issues               Issue[]
  apiKeys              ProjectApiKey[]
  sourceMaps           SourceMap[]
  memberships          ProjectMembership[]
  routingRules         RoutingRule[]
  alertPolicies        AlertPolicy[]
  dailyUsage           ProjectDailyUsage[]
  onCallRotation       OnCallRotation?

  @@index([orgId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  issues    Issue[]
  memberships TeamMembership[]
  routingRules RoutingRule[]

  @@index([projectId])
}

model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, role])
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
}

model Job {
  id        String   @id @default(cuid())
  type      JobType
  payload   Json
  status    JobStatus @default(PENDING)
  runAfter  DateTime @default(now())
  attempts  Int      @default(0)
  lockedAt  DateTime?
  lockedBy  String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
  @@index([type, status, runAfter])
}

model RoutingRule {
  id           String           @id @default(cuid())
  projectId    String
  targetTeamId String
  matchType    RoutingMatchType
  matchValue   String
  enabled      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetTeam   Team             @relation(fields: [targetTeamId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled, createdAt])
  @@index([targetTeamId])
}

model AlertPolicy {
  id           String        @id @default(cuid())
  projectId    String
  name         String
  severity     IssueSeverity
  threshold    Int
  windowMinutes Int
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggers     AlertTrigger[]

  @@index([projectId, enabled, severity])
}

model AlertTrigger {
  id           String      @id @default(cuid())
  policyId     String
  issueId      String
  windowStart  DateTime
  createdAt    DateTime    @default(now())
  policy       AlertPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  issue        Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([policyId, issueId, windowStart])
  @@index([issueId, createdAt(sort: Desc)])
}

model ProjectDailyUsage {
  projectId  String
  day        DateTime @db.Date
  eventCount Int      @default(0)
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, day])
  @@index([day])
}

model OnCallRotation {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  name               String
  timezone           String   @default("UTC")
  startsAt           DateTime
  shiftDurationHours Int      @default(24)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members            OnCallRotationMember[]
}

model OnCallRotationMember {
  id         String         @id @default(cuid())
  rotationId String
  userId     String
  position   Int
  rotation   OnCallRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rotationId, userId])
  @@unique([rotationId, position])
  @@index([userId])
}

model Issue {
  id                  String        @id @default(cuid())
  githubDeliveryId    String?       @unique
  fingerprint         String?
  timesSeen           Int           @default(1)
  lastSeenAt          DateTime      @default(now())
  title               String
  description         String
  source              IssueSource   @default(MANUAL)
  release             String?
  severity            IssueSeverity @default(LOW)
  priority            IssuePriority? @default(MEDIUM)
  status              IssueStatus   @default(OPEN)
 
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assignedToId        String?
  assignedTo          User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  teamId              String?
  team                Team?         @relation(fields: [teamId], references: [id])
  
  logs                Json?         
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  acceptedAt          DateTime?
  resolvedAt          DateTime?
  deletedAt           DateTime?     // Soft delete
  
  responseSlaDeadline DateTime?
  resolutionSlaDeadline DateTime?
  responseBreached    Boolean       @default(false)
  resolutionBreached  Boolean       @default(false)

  environment         EnvironmentType @default(PRODUCTION)
  rootCause           String?
  suggestedFixes      String?

  activities          IssueActivity[]

  comments            IssueComment[]
  alertTriggers       AlertTrigger[]

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assignedToId])
  @@index([teamId])
  @@index([createdAt(sort: Desc)])
  @@index([projectId, fingerprint])
  @@index([projectId, release, createdAt(sort: Desc)])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  createdAt DateTime @default(now())

  @@index([issueId, createdAt(sort: Desc)])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, createdAt])
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String
  projectId String
  orgId     String?
  teamId    String?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([email, projectId])
  @@index([email, projectId])
}

model ProjectApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([projectId])
  @@index([keyHash])
}

model SourceMap {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release   String
  filename  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([projectId, release, filename])
  @@index([projectId, release])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
}
