generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@devnexus/prisma-client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  UNVERIFIED
}

enum PlanType {
  BASIC
  ADVANCED
  PRO
  ENTERPRISE
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum IssueSource {
  MANUAL
  GITHUB
  SDK
  AI
}

enum EnvironmentType {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  plan      PlanType  @default(BASIC)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  users     User[]
  projects  Project[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           Role
  status         UserStatus   @default(UNVERIFIED)
  name           String?
  bio            String?
  image          String?
  phoneNumber    String?
  location       String?
  githubUrl      String?
  linkedinUrl    String?
  skills         String[]
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  projectId      String?
  project        Project?      @relation("ManagedBy", fields: [projectId], references: [id])
  teamId         String?
  team           Team?         @relation("TeamMembers", fields: [teamId], references: [id])
  
  emailVerifiedAt DateTime?
  deletedAt       DateTime?    // Soft delete
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedIssues Issue[]      @relation("AssignedTo")
  activities     IssueActivity[]
  comments       IssueComment[]
  createdProjects Project[]   @relation("CreatedProjects")
  notifications  Notification[]

  @@index([orgId])
  @@index([teamId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'INCIDENT_CREATED', 'ASSIGNMENT', 'COMMENT', 'SLA'
  title     String
  message   String
  link      String?  // e.g., '/dashboard/issues/id'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model Project {
  id                   String       @id @default(cuid())
  name                 String
  description          String?
  techStack            String[]
  orgId                String
  organization         Organization @relation(fields: [orgId], references: [id])
  createdBy            String?
  creator              User?        @relation("CreatedProjects", fields: [createdBy], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?    // Soft delete

  plan                 PlanType     @default(BASIC)
  githubRepoUrl        String?
  githubInstallationId String?
  sdkApiKey            String?      @unique
  allowedOrigins       String[]     @default([])

  teams                Team[]
  issues               Issue[]
  managers             User[]       @relation("ManagedBy")

  @@index([orgId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  issues    Issue[]
  members   User[]   @relation("TeamMembers")

  @@index([projectId])
}

model Issue {
  id                  String        @id @default(cuid())
  title               String
  description         String
  source              IssueSource   @default(MANUAL)
  severity            IssueSeverity @default(LOW)
  priority            IssuePriority? @default(MEDIUM)
  status              IssueStatus   @default(OPEN)
 
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assignedToId        String?
  assignedTo          User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  teamId              String?
  team                Team?         @relation(fields: [teamId], references: [id])
  
  logs                Json?         
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  acceptedAt          DateTime?
  resolvedAt          DateTime?
  deletedAt           DateTime?     // Soft delete
  
  responseSlaDeadline DateTime?
  resolutionSlaDeadline DateTime?
  responseBreached    Boolean       @default(false)
  resolutionBreached  Boolean       @default(false)

  environment         EnvironmentType @default(PRODUCTION)
  rootCause           String?
  suggestedFixes      String?

  activities          IssueActivity[]

  comments            IssueComment[]

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([assignedToId])
  @@index([teamId])
  @@index([createdAt(sort: Desc)])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  createdAt DateTime @default(now())

  @@index([issueId, createdAt(sort: Desc)])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, createdAt])
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String
  projectId String
  orgId     String?
  teamId    String?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([email, projectId])
  @@index([email, projectId])
}
