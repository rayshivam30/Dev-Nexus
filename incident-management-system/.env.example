# ── DATABASE ──────────────────────────────────────────────────────────────────
# Prisma connection string (PostgreSQL via Neon Pooler)
# Use the -pooler endpoint for PgBouncer connection multiplexing.
DATABASE_URL="your db url"

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens (Generate a random 32+ char string)
JWT_SECRET="your_jwt_secret_here"

# ── AI SERVICES ───────────────────────────────────────────────────────────────
# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"

# ── INFRASTRUCTURE ────────────────────────────────────────────────────────────
# Redis (required in production for distributed throttling/session security)
# Get from Upstash
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Metrics endpoint access token (required by production Compose)
METRICS_BEARER_TOKEN="generate_a_long_random_token"

# Email Service (Used for Verification & Invites)
# Gmail SMTP — generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER="your_email"
GMAIL_APP_PASSWORD="password_generated"
# Optional: probe SMTP once when the server starts (never during the build).
SMTP_VERIFY_ON_STARTUP="false"

# ── GITHUB INTEGRATION ────────────────────────────────────────────────────────
# GitHub App Details (Create at GitHub Developer Settings)
NEXT_PUBLIC_GITHUB_APP_SLUG="your_app_slug"
GITHUB_APP_ID="your_app_id"
GITHUB_CLIENT_ID="your_client_id"
GITHUB_CLIENT_SECRET="your_client_secret"

# Webhook Secret (The one you set in the GitHub App settings)
# Subscribe the GitHub App webhook to: Workflow run, Check run, Check suite, and Pull request events.
GITHUB_WEBHOOK_SECRET="your_webhook_secret"

# ── TESTING (Optional) ────────────────────────────────────────────────────────
# SDK API key for load-test.ts and test-sdk.ts scripts
# Get this from Project -> SDK Integration in the admin dashboard
TEST_SDK_API_KEY=""

# ── APP CONFIG ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
