# Copy to .env at the repository root before running Docker Compose.
# Keep real secrets out of source control.
POSTGRES_PASSWORD="generate_a_local_database_password"
JWT_SECRET="generate_a_random_secret_at_least_32_characters"
GITHUB_WEBHOOK_SECRET="configure_the_same_secret_in_your_github_app"

# Required for production throttling, refresh-token security, and cross-instance SSE.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"
METRICS_BEARER_TOKEN="generate_a_long_random_token"

# Optional integrations
GEMINI_API_KEY=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional SMTP override for local development and test sinks; Gmail remains the default.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_VERIFY_ON_STARTUP="false"
GITHUB_APP_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_APP_SLUG=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
