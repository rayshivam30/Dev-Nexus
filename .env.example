# Copy to .env at the repository root before running Docker Compose.
# Keep real secrets out of source control.
POSTGRES_PASSWORD="generate_a_local_database_password"
JWT_SECRET="generate_a_random_secret_at_least_32_characters"
GITHUB_WEBHOOK_SECRET="configure_the_same_secret_in_your_github_app"
METRICS_BEARER_TOKEN="generate_a_long_random_token"

# ── Local Redis (100% in Docker) ─────────────────────────────────────────────
# Automatically points to the local Redis container via serverless-redis-http proxy
UPSTASH_REDIS_REST_URL="http://redis-http:80"
UPSTASH_REDIS_REST_TOKEN="devnexus_local_redis_token"

# ── Local Email Delivery (Mailpit in Docker) ─────────────────────────────────
# All sent emails are captured locally and viewable at http://localhost:8025
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_VERIFY_ON_STARTUP="false"

# Optional Gmail Override:
# SMTP_HOST=""
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"

# Optional integrations
GEMINI_API_KEY=""
GITHUB_APP_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_APP_SLUG=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
